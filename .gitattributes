# Kodinn's installers are larger than the 100 MB GitHub accepts in a repository:
# they are stored with Git LFS (https://git-lfs.com).
Builds/**/*.exe filter=lfs diff=lfs merge=lfs -text
Builds/**/*.msi filter=lfs diff=lfs merge=lfs -text
Builds/**/*.msix filter=lfs diff=lfs merge=lfs -text
Builds/**/*.msixbundle filter=lfs diff=lfs merge=lfs -text
Builds/**/*.pkg filter=lfs diff=lfs merge=lfs -text
Builds/**/*.dmg filter=lfs diff=lfs merge=lfs -text
Builds/**/*.zip filter=lfs diff=lfs merge=lfs -text
